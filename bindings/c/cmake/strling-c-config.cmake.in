@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Reject an archive accidentally paired with another product package. The
# product marker is package data; it does not add an ABI symbol or protocol field.
file(SIZE "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/@STRLING_INTEROP_ARCHIVE_NAME@" _strling_archive_size)
if(_strling_archive_size GREATER 134217728)
    message(FATAL_ERROR "Native STRling archive exceeds the package size limit")
endif()
unset(_strling_archive_size)
file(STRINGS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/@STRLING_INTEROP_ARCHIVE_NAME@"
    _strling_product_markers REGEX "^STRLING-PRODUCT-VERSION:" LIMIT_INPUT 134217729)
list(LENGTH _strling_product_markers _strling_marker_count)
if(NOT _strling_marker_count EQUAL 1 OR
   NOT _strling_product_markers STREQUAL "STRLING-PRODUCT-VERSION:@PROJECT_VERSION@")
    message(FATAL_ERROR "Native STRling archive product identity mismatch")
endif()
unset(_strling_product_markers)
unset(_strling_marker_count)


if(NOT WIN32)
    find_dependency(Threads)
endif()

if(NOT TARGET STRling::interop)
    add_library(STRling::interop STATIC IMPORTED)
    set_target_properties(
        STRling::interop
        PROPERTIES
            IMPORTED_LOCATION
                "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/@STRLING_INTEROP_ARCHIVE_NAME@"
            INTERFACE_INCLUDE_DIRECTORIES
                "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@"
    )
endif()

if(NOT TARGET STRling::c)
    add_library(STRling::c STATIC IMPORTED)
    set_target_properties(
        STRling::c
        PROPERTIES
            IMPORTED_LOCATION
                "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/@STRLING_C_ARCHIVE_NAME@"
            INTERFACE_INCLUDE_DIRECTORIES
                "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@"
    )
    if(WIN32)
        set_property(
            TARGET STRling::c
            PROPERTY INTERFACE_LINK_LIBRARIES
                "STRling::interop;advapi32;bcrypt;ntdll;userenv;ws2_32"
        )
    else()
        set_property(
            TARGET STRling::c
            PROPERTY INTERFACE_LINK_LIBRARIES
                "STRling::interop;Threads::Threads;${CMAKE_DL_LIBS};m"
        )
    endif()
endif()

check_required_components(strling-c)
