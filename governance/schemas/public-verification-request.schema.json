{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://strling.dev/governance/public-verification-request.schema.json",
    "title": "Protected independent public verification request v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "contract",
        "version",
        "channel",
        "certified_source_sha",
        "closure_source_sha",
        "signed_evidence_root",
        "manifest_fingerprint",
        "destinations",
        "documents",
        "publication_receipts",
        "obligations",
        "lifecycle_state",
        "authority"
    ],
    "properties": {
        "contract": {
            "const": "strling-public-distribution-v1"
        },
        "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-rc\\.[1-9][0-9]*)?$"
        },
        "channel": {
            "enum": ["stable", "release-candidate"]
        },
        "certified_source_sha": {
            "$ref": "#/$defs/commit"
        },
        "closure_source_sha": {
            "$ref": "#/$defs/commit"
        },
        "signed_evidence_root": {
            "$ref": "#/$defs/digest"
        },
        "manifest_fingerprint": {
            "$ref": "#/$defs/digest"
        },
        "authority": {
            "enum": ["public", "synthetic", "staged"]
        },
        "lifecycle_state": {
            "enum": ["certified", "published"]
        },
        "destinations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "artifact_id",
                    "registry",
                    "package_name",
                    "registry_owner",
                    "tier"
                ],
                "properties": {
                    "artifact_id": {
                        "type": "string"
                    },
                    "registry": {
                        "type": "string"
                    },
                    "package_name": {
                        "type": "string"
                    },
                    "registry_owner": {
                        "type": "string",
                        "minLength": 1
                    },
                    "tier": {
                        "enum": ["Supported", "Preview"]
                    },
                    "registry_endpoint": {
                        "type": "string",
                        "pattern": "^https://"
                    }
                }
            }
        },
        "documents": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "artifact_id",
                    "sbom",
                    "provenance",
                    "documentation"
                ],
                "properties": {
                    "artifact_id": {
                        "type": "string"
                    },
                    "sbom": {
                        "$ref": "#/$defs/document"
                    },
                    "provenance": {
                        "$ref": "#/$defs/document"
                    },
                    "documentation": {
                        "$ref": "#/$defs/document"
                    }
                }
            }
        },
        "publication_receipts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "object",
                "required": ["artifact_id"],
                "properties": {
                    "artifact_id": {
                        "type": "string"
                    }
                },
                "description": "Informational publication correlation only; never verification authority."
            }
        },
        "obligations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "$ref": "#/$defs/obligation"
            }
        }
    },
    "$defs": {
        "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
        },
        "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "document": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "sha256"],
            "properties": {
                "url": {
                    "type": "string",
                    "pattern": "^https://"
                },
                "sha256": {
                    "$ref": "#/$defs/digest"
                }
            }
        },
        "obligation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "artifact_id", "check", "platform", "tier"],
            "properties": {
                "id": {
                    "type": "string"
                },
                "artifact_id": {
                    "type": "string"
                },
                "check": {
                    "type": "string"
                },
                "platform": {
                    "enum": [null, "windows-x86_64", "linux-x86_64"]
                },
                "tier": {
                    "enum": ["Supported", "Preview"]
                }
            }
        }
    }
}
